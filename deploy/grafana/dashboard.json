{
  "uid": "ringwatch-engine",
  "title": "Fraud ring engine and replication",
  "schemaVersion": 39,
  "refresh": "5s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Operation latency by operation",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "fraud-prom"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le,op) (rate(fraud_operation_latency_seconds_bucket[2m])))",
          "legendFormat": "p50 {{op}}"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.99, sum by (le,op) (rate(fraud_operation_latency_seconds_bucket[2m])))",
          "legendFormat": "p99 {{op}}"
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.999, sum by (le,op) (rate(fraud_operation_latency_seconds_bucket[2m])))",
          "legendFormat": "p99.9 {{op}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Service operation rate",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "fraud-prom"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(op) (rate(fraud_operation_latency_seconds_count[2m]))",
          "legendFormat": "{{op}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "HDT replacement search",
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "fraud-prom"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(hdt_replacement_search_levels_traversed[2m]))",
          "legendFormat": "hdt_replacement_search_levels_traversed"
        },
        {
          "refId": "B",
          "expr": "sum(rate(hdt_nontree_edges_scanned_total[2m]))",
          "legendFormat": "hdt_nontree_edges_scanned_total"
        },
        {
          "refId": "C",
          "expr": "sum(rate(hdt_edge_promotions_total[2m]))",
          "legendFormat": "hdt_edge_promotions_total"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "LCT manual repairs",
      "gridPos": {
        "x": 12,
        "y": 7,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "fraud-prom"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(lct_repair_triggered_total[2m]))",
          "legendFormat": "lct_repair_triggered_total"
        },
        {
          "refId": "B",
          "expr": "sum(rate(lct_repair_subtree_vertices_scanned[2m]))",
          "legendFormat": "lct_repair_subtree_vertices_scanned"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Suppressed hubs",
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "fraud-prom"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "hub_suppressed_active_count",
          "legendFormat": "{{instance}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Hub transitions",
      "gridPos": {
        "x": 12,
        "y": 14,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "fraud-prom"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(hub_transition_events_total[2m]))",
          "legendFormat": "transitions/s"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "WAL fsync latency",
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "fraud-prom"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(wal_fsync_latency_seconds_bucket[2m])))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "WAL write rate",
      "gridPos": {
        "x": 12,
        "y": 21,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "fraud-prom"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(wal_bytes_written_total[2m])",
          "legendFormat": "{{instance}}"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Replica lag",
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "fraud-prom"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "replica_lsn_lag",
          "legendFormat": "{{instance}}"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Snapshot duration",
      "gridPos": {
        "x": 12,
        "y": 28,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "fraud-prom"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(snapshot_duration_seconds_bucket[2m])))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Lease acquisition to write readiness",
      "gridPos": {
        "x": 0,
        "y": 35,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "fraud-prom"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(failover_duration_seconds_bucket[2m])))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Pending requests and shedding",
      "gridPos": {
        "x": 12,
        "y": 35,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "fraud-prom"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "ingestion_queue_depth",
          "legendFormat": "queued {{instance}}"
        },
        {
          "refId": "B",
          "expr": "increase(shed_requests_total[2m])",
          "legendFormat": "shed in 2m {{instance}}"
        }
      ]
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Engine index storage",
      "gridPos": {
        "x": 0,
        "y": 42,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "fraud-prom"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "engine_memory_bytes",
          "legendFormat": "{{instance}}"
        }
      ]
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Pending request bytes",
      "gridPos": {
        "x": 12,
        "y": 42,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "fraud-prom"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "ingestion_pending_bytes",
          "legendFormat": "{{instance}}"
        }
      ]
    }
  ]
}
